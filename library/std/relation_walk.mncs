mncs 0.13;

// mncs.std.relation_walk.v1 — bounded incremental reachability state.
//
// Consumers keep ownership of domain-specific edge discovery and identity
// mapping, then submit compact per-query node codes in fixed 64-item batches.
// This kernel owns first-visit admission, breadth-first frontier accumulation,
// the result budget, and explicit truncation. Code 0..1024 is the per-query
// interning window: the root uses one code and at most 1024 result nodes are
// admitted. A depth change starts a fresh output frontier while preserving
// the visited table.
//
// Storage is fixed: 1025 visited bits and a 1024-node frontier. Each advance
// inspects at most 64 candidate codes and performs bounded direct-index state
// updates. The consumer may call advance repeatedly at the same depth to
// stream larger adjacency lists without losing duplicate or cycle handling.
module mncs.std.relation_walk.v1;

record WalkState {
    // Result codes use 0..1023. Code 1024 is the reserved root sentinel.
    seen: [bool; 1024],
    root_seen: bool,
    frontier: [u64; 1024],
    frontier_count: u64,
    reached_count: u64,
    frontier_depth: u64,
    truncated: bool,
    valid: bool
}

record AdvanceOut {
    state: WalkState,
    accepted: [bool; 64],
    accepted_count: u64
}

record AdvanceFold {
    state: WalkState,
    accepted: [bool; 64],
    accepted_count: u64
}

// Start a query with the reserved root sentinel (code 1024) at depth zero.
// Result nodes use the compact 0..1023 range assigned by the consumer.
fn walk_start(root: u64) -> (result: WalkState) {
    let valid: bool = root == 1024;
    let empty_seen: [bool; 1024] = [false; 1024];
    let empty_frontier: [u64; 1024] = [0; 1024];
    let frontier: [u64; 1024] = replace(empty_frontier, 0, 1024);
    return WalkState {
        seen: empty_seen,
        root_seen: valid,
        frontier: frontier,
        frontier_count: 1,
        reached_count: 1,
        frontier_depth: 0,
        truncated: false,
        valid: valid
    };
}

// Admit one adjacency batch. The accepted mask corresponds positionally to
// candidates and lets the domain adapter attach URI/module or symbol details
// without maintaining a second host-language visited set.
fn walk_advance(
    state: WalkState,
    candidates: [u64; 64],
    count: u64,
    depth: u64,
    max_nodes: u64
) -> (result: AdvanceOut) {
    let count_valid: bool = count <= 64;
    let depth_valid: bool = depth > 0 && depth <= 16;
    let budget_valid: bool = max_nodes <= 1024;
    let state_valid: bool = state.valid
        && state.frontier_count <= 1024
        && state.reached_count <= 1025
        && state.frontier_depth <= 16;
    iterate i over candidates carrying codes_valid: bool = true {
        let active: bool = i < count;
        next codes_valid = codes_valid && (!active || candidates[i] <= 1024);
    }
    let request_valid: bool = count_valid && depth_valid && budget_valid
        && state_valid && codes_valid;
    let same_depth: bool = state.frontier_depth == depth;
    let initial_state: WalkState = WalkState {
        seen: state.seen,
        root_seen: state.root_seen,
        frontier: state.frontier,
        frontier_count: select(same_depth, state.frontier_count, 0),
        reached_count: state.reached_count,
        frontier_depth: depth,
        truncated: state.truncated,
        valid: request_valid
    };
    let empty_accepted: [bool; 64] = [false; 64];
    let seed: AdvanceFold = AdvanceFold {
        state: initial_state,
        accepted: empty_accepted,
        accepted_count: 0
    };
    let cap: u64 = select(max_nodes < 1024, max_nodes +% 1, 1025);
    iterate i over candidates carrying fold: AdvanceFold = seed {
        let active: bool = request_valid && i < count && !fold.state.truncated;
        let code: u64 = candidates[i];
        let code_slot: u64 = select(code < 1024, code, 0);
        let is_root: bool = code == 1024;
        let already_seen: bool = (is_root && fold.state.root_seen)
            || (!is_root && fold.state.seen[code_slot]);
        let fresh: bool = active && !already_seen;
        let room: bool = fold.state.reached_count < cap;
        let join: bool = fresh && room;
        let seen: [bool; 1024] = replace(
            fold.state.seen,
            code_slot,
            fold.state.seen[code_slot] || (join && !is_root)
        );
        let root_seen: bool = fold.state.root_seen || (join && is_root);
        let frontier_slot: u64 = select(join, fold.state.frontier_count, 0);
        let previous_frontier_value: u64 = fold.state.frontier[frontier_slot];
        let frontier: [u64; 1024] = replace(
            fold.state.frontier,
            frontier_slot,
            select(join, code, previous_frontier_value)
        );
        let reached_count: u64 = fold.state.reached_count +% select(join, 1, 0);
        let frontier_count: u64 = fold.state.frontier_count +% select(join, 1, 0);
        let reached_budget: bool = join && reached_count >= cap;
        let refused: bool = fresh && !room;
        next fold = AdvanceFold {
            state: WalkState {
                seen: seen,
                root_seen: root_seen,
                frontier: frontier,
                frontier_count: frontier_count,
                reached_count: reached_count,
                frontier_depth: fold.state.frontier_depth,
                truncated: fold.state.truncated || refused || reached_budget,
                valid: request_valid
            },
            accepted: replace(fold.accepted, i, join),
            accepted_count: fold.accepted_count +% select(join, 1, 0)
        };
    }
    return AdvanceOut {
        state: fold.state,
        accepted: fold.accepted,
        accepted_count: fold.accepted_count
    };
}
