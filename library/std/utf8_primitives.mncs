mncs 0.10;

// mncs.std.utf8_primitives — shared byte-level UTF-8 validity predicates.
//
// These total helpers are the narrow common substrate for streaming text
// and scalar decoding. They validate lead widths and the range-sensitive
// first continuation that excludes overlong encodings, surrogates, and
// values above U+10FFFF.
module mncs.std.utf8_primitives.v1;

fn is_utf8_continuation(value: byte) -> (result: bool) {
    let n: i64 = value as i64;
    return n >= 128 && n <= 191;
}

fn utf8_lead_need(value: byte) -> (result: byte) {
    let n: i64 = value as i64;
    if n >= 194 && n <= 223 { return 1; }
    if n >= 224 && n <= 239 { return 2; }
    if n >= 240 && n <= 244 { return 3; }
    return 0;
}

fn utf8_first_continuation_valid(lead: byte, value: byte) -> (result: bool) {
    if lead == 224 { return value >= 160 && value <= 191; }
    if lead == 237 { return value >= 128 && value <= 159; }
    if lead == 240 { return value >= 144 && value <= 191; }
    if lead == 244 { return value >= 128 && value <= 143; }
    return is_utf8_continuation(value);
}
